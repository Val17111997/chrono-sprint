{
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Cross-Origin-Opener-Policy",
     "value": "same-origin"
    },
    {
     "key": "Cross-Origin-Embedder-Policy",
     "value": "require-corp"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(self), microphone=(self)"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  }
 ]
}